// Prisma + SQLite: no native enums or array columns.
// - status / action are stored as strings and validated in code (see src/lib/constants.ts).
// - riskFlags is a JSON-encoded string[] and validated in code.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Application {
  id             String     @id @default(cuid())
  applicantName  String
  dob            DateTime
  mockDocumentId String
  address        String
  riskFlags      String     @default("[]") // JSON-encoded string[]
  status         String     @default("pending") // pending | approved | rejected
  submittedAt    DateTime   @default(now())
  auditLogs      AuditLog[]

  @@index([status])
}

// Append-only, hash-chained audit trail. Rows are only ever inserted, never
// updated or deleted. Each row commits to the previous row's hash, so any
// edit/reorder/delete breaks the chain and is detectable (see src/lib/hashchain.ts).
model AuditLog {
  id            String      @id @default(cuid())
  seq           Int         @unique // monotonic chain position (assigned in the decision transaction)
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  actor         String
  action        String // approve | reject
  fromStatus    String
  toStatus      String
  reason        String?
  createdAt     DateTime    @default(now())

  // Tamper-evidence: rowHash = sha256(prevHash + canonical(row content)).
  prevHash      String? // rowHash of the preceding entry; null for the genesis row
  rowHash       String // this row's chain hash

  @@index([createdAt])
  @@index([seq])
}
